# Copy to .env and fill in. See SECURITY.md for the production checklist.

# --- App ---
APP_NAME=Lambda API
# Leave false in production: true exposes stack traces and SQL query logs.
DEBUG=false

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lambda

# --- Admin endpoints (X-Admin-Key, or an admin session token) ---
# Long random value. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# If empty, admin routes return 503 (disabled).
ADMIN_API_KEY=
# How long an admin console session lasts before it has to sign in again.
ADMIN_TOKEN_TTL_MINUTES=480
# Limits on POST /admin/session. The admin key has no lockout, so these are what
# make online guessing impractical -- do not raise them casually. The per-IP one
# is bypassed by using more IPs, so the global bucket caps the endpoint as a
# whole. Both need RATE_LIMIT_STORAGE_URI set to mean anything on >1 instance.
RATE_LIMIT_ADMIN_SESSION=5/minute
RATE_LIMIT_ADMIN_SESSION_GLOBAL=50/hour
#
# Rotating ADMIN_API_KEY now invalidates every outstanding admin session token
# (they carry a fingerprint of the key that minted them) -- so it doubles as
# "sign out everywhere" if a key or a laptop goes missing.

# --- Auth ---
# Long random value. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# REQUIRED even in guest-only mode: admin session tokens are signed with this,
# so the admin console cannot sign in without it.
JWT_SECRET=
# DEV ONLY. Short-circuits JWT auth and returns this user id. MUST be empty in production.
AUTH_BYPASS_USER_ID=

# --- CORS ---
# Comma/JSON list of allowed frontend origins. Default is localhost-only;
# set your real frontend origin(s) in production. Do not use "*" with credentials.
# CORS_ORIGINS=["https://your-frontend.example.com"]

# --- Rate limiting ---
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_SUBMIT=5/minute
RATE_LIMIT_SUBMIT_GLOBAL=200/hour
# Quiz-attempt creation has its own buckets: it is open and writes up to 101 rows
# per call, so it must not share the submit budget above. The global value is an
# emergency ceiling, not a throttle -- keep it well above real peak traffic,
# because exhausting it rate-limits every user at once.
RATE_LIMIT_ATTEMPT_CREATE=10/minute
RATE_LIMIT_ATTEMPT_GLOBAL=2000/hour
# Number of proxies that append to X-Forwarded-For. The client IP is read this
# many entries from the RIGHT (entries further left are client-written and
# spoofable). 1 behind a single edge (Railway); 0 if exposed directly. Too high
# = rate limits bypassable; too low = all users share one bucket. See SECURITY.md.
TRUSTED_PROXY_HOPS=1
# Empty = in-memory (single instance only). For multiple instances, use Redis:
# RATE_LIMIT_STORAGE_URI=redis://default:password@host:6379
RATE_LIMIT_STORAGE_URI=

# --- Data retention ---
# Anonymous attempts have no owner and no expiry. scripts/purge_stale_attempts.py
# deletes attempts left in progress (completed_at IS NULL) for longer than this.
# Completed attempts are never purged. Schedule the job -- see SECURITY.md.
ATTEMPT_RETENTION_DAYS=7

# --- Analytics (PostHog) ---
# Project API key. Empty = analytics disabled (no client, no events). Find it in
# PostHog under Settings > Project > Project API Key.
POSTHOG_API_KEY=
# Ingestion host. US Cloud by default; use https://eu.i.posthog.com for EU Cloud
# or your own URL when self-hosting.
POSTHOG_HOST=https://us.i.posthog.com
# Salt for the anonymous distinct_id. Unauthenticated requests are identified by
# HMAC(salt, client_ip), so raw IPs never reach PostHog. Set this in production:
# when empty a random per-process salt is used instead, which still keeps IPs in,
# but anonymous ids then differ per instance and reset on every redeploy.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Treat it like a secret and keep it stable -- changing it re-buckets every
# anonymous visitor.
ANALYTICS_IP_SALT=
